            "items": [
              "banner",
              "interstitial",
              "rewarded",
              "native",
              "app_open",
              "other"
            ],
            "initialValue": "rewarded"
          },
          {
            "id": "result",
            "type": "combo",
            "items": [
              "shown",
              "clicked",
              "failed",
              "rewarded"
            ],
            "initialValue": "clicked"
          },
          {
            "id": "placement",
            "type": "string"
          }
        ]
      },
      {
