            "id": "severity",
            "type": "combo",
            "items": [
              "debug",
              "info",
              "warning",
              "error",
              "critical"
            ],
            "initialValue": "error"
          },
          {
            "id": "message",
            "type": "string"
          }
        ]
      },
      {
        "id": "track-ad",
        "scriptName": "TrackAd",
        "params": [
          {
            "id": "network",
            "type": "string"
          },
          {
            "id": "format",
