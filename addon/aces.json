          },
          {
            "id": "property",
            "type": "string"
          },
          {
            "id": "value",
            "type": "any"
          }
        ]
      },
      {
        "id": "level-start",
        "scriptName": "LevelStart",
        "params": [
          {
            "id": "level",
            "type": "string"
          }
        ]
      },
      {
        "id": "level-complete",
        "scriptName": "LevelComplete",
        "params": [
          {
            "id": "level",
            "type": "string"
          }
        ]
      },
      {
        "id": "death",
        "scriptName": "Death",
        "params": [
          {
            "id": "level",
            "type": "string"
          }
        ]
      },
      {
